{
  "manifest_version": 1,
  "type": "device",
  "name": "LG webOS",
  "description": {
    "en": "Control an LG webOS television locally from Gladys Assistant.",
    "fr": "Contrôlez localement une télévision LG webOS depuis Gladys Assistant."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/vincentbesseau/gladys-lg-webos:1.0.0",
  "gladys_version": ">=4.84.3",
  "cover_image": "https://raw.githubusercontent.com/vincentBesseau/gladys-lg-webos/main/cover.png",
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "ssdp",
      "st": "urn:lge-com:service:webos-second-screen:1"
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "LG webOS TV", "fr": "TV LG webOS" },
      "description": {
        "en": "Start with the Discover tab. Gladys performs the SSDP scan from the host network, then the integration connects locally to the selected TV. Manual IP/MAC fields below are available as a fallback and for Wake-on-LAN.",
        "fr": "Commencez par l'onglet Découvrir. Gladys effectue le scan SSDP depuis le réseau hôte, puis l'intégration se connecte localement à la TV sélectionnée. Les champs IP/MAC ci-dessous restent disponibles en secours et pour le Wake-on-LAN."
      }
    },
    {
      "key": "tv_ip",
      "type": "text",
      "label": { "en": "TV IP address", "fr": "Adresse IP de la TV" },
      "description": {
        "en": "Optional when using network discovery.",
        "fr": "Facultative si vous utilisez la découverte réseau."
      },
      "required": false
    },
    {
      "key": "tv_mac",
      "type": "text",
      "label": { "en": "TV MAC address", "fr": "Adresse MAC de la TV" },
      "description": {
        "en": "Optional for discovery and control, but required to turn the TV on with Wake-on-LAN.",
        "fr": "Facultative pour la découverte et le contrôle, mais nécessaire pour allumer la TV avec Wake-on-LAN."
      },
      "required": false
    },
    {
      "key": "tv_name",
      "type": "text",
      "label": { "en": "TV name", "fr": "Nom de la TV" },
      "default": "LG webOS TV",
      "required": false
    },
    {
      "key": "connection_mode",
      "type": "select",
      "label": { "en": "Connection mode", "fr": "Mode de connexion" },
      "default": "auto",
      "required": false,
      "options": [
        { "value": "auto", "label": { "en": "Automatic", "fr": "Automatique" } },
        {
          "value": "ws",
          "label": { "en": "WebSocket (port 3000)", "fr": "WebSocket (port 3000)" }
        },
        {
          "value": "wss",
          "label": { "en": "Secure WebSocket (port 3001)", "fr": "WebSocket sécurisé (port 3001)" }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test TV connection", "fr": "Tester la connexion à la TV" },
      "timeout_seconds": 30
    },
    {
      "key": "test_toast",
      "label": { "en": "Send a test notification", "fr": "Envoyer une notification de test" },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "message",
          "type": "text",
          "label": { "en": "Message", "fr": "Message" },
          "required": false
        }
      ]
    }
  ]
}
