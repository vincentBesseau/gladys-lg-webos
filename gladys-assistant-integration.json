{
  "manifest_version": 1,
  "type": "device",
  "name": "LG webOS",
  "description": {
    "en": "Control an LG webOS television locally from Gladys Assistant.",
    "fr": "Contrôlez localement une télévision LG webOS depuis Gladys Assistant."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/vincentbesseau/gladys-lg-webos:1.0.0",
  "gladys_version": ">=4.84.3",
  "cover_image": "https://raw.githubusercontent.com/vincentBesseau/gladys-lg-webos/main/cover.png",
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "LG webOS TV", "fr": "TV LG webOS" },
      "description": {
        "en": "The TV must be reachable on the same local network. On first connection, accept the pairing prompt displayed on the TV.",
        "fr": "La TV doit être joignable sur le même réseau local. Lors de la première connexion, acceptez la demande d'association affichée sur la TV."
      }
    },
    {
      "key": "tv_ip",
      "type": "text",
      "label": { "en": "TV IP address", "fr": "Adresse IP de la TV" },
      "required": true
    },
    {
      "key": "tv_mac",
      "type": "text",
      "label": { "en": "TV MAC address", "fr": "Adresse MAC de la TV" },
      "description": {
        "en": "Used as the stable device identifier and for Wake-on-LAN.",
        "fr": "Utilisée comme identifiant stable de l'appareil et pour le Wake-on-LAN."
      },
      "required": true
    },
    {
      "key": "tv_name",
      "type": "text",
      "label": { "en": "TV name", "fr": "Nom de la TV" },
      "default": "LG webOS TV",
      "required": false
    },
    {
      "key": "connection_mode",
      "type": "select",
      "label": { "en": "Connection mode", "fr": "Mode de connexion" },
      "default": "auto",
      "required": false,
      "options": [
        { "value": "auto", "label": { "en": "Automatic", "fr": "Automatique" } },
        { "value": "ws", "label": { "en": "WebSocket (port 3000)", "fr": "WebSocket (port 3000)" } },
        { "value": "wss", "label": { "en": "Secure WebSocket (port 3001)", "fr": "WebSocket sécurisé (port 3001)" } }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test TV connection", "fr": "Tester la connexion à la TV" },
      "timeout_seconds": 30
    },
    {
      "key": "test_toast",
      "label": { "en": "Send a test notification", "fr": "Envoyer une notification de test" },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "message",
          "type": "text",
          "label": { "en": "Message", "fr": "Message" },
          "required": false
        }
      ]
    }
  ]
}
